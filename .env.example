# Supabase project (Project Settings → API). The publishable/anon key is safe to expose in the browser:
# all access is enforced by Row Level Security (see supabase/migrations).
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-OR-ANON-KEY

# Optional: public origin used to build the patient QR links (defaults to the current origin).
# VITE_PUBLIC_ORIGIN=https://entsenses.app
